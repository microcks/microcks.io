{
  "name": "microcks-io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "optimize-images": "node scripts/optimize-images.mjs",
    "prebuild": "node scripts/ensure-descriptions.mjs",
    "build": "docusaurus build && node scripts/preload-fonts.mjs && node scripts/generate-route-markdown.mjs && node scripts/validate-machine-content.mjs",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "check:parity": "node scripts/check-url-parity.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "docusaurus-plugin-llms": "0.6.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "gray-matter": "4.0.3",
    "js-yaml": "^5.5.0",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=20.0"
  }
}
